{
  "name": "phantom-tower",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.js",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && npm run build:server && electron-builder --win nsis",
    "dist:mac": "npm run build && npm run build:server && electron-builder --mac dmg",
    "license:issue": "node cloudflare-api/scripts/license-manager-tencent.cjs issue",
    "license:revoke": "node cloudflare-api/scripts/license-manager-tencent.cjs revoke",
    "license:admin": "node cloudflare-api/scripts/license-admin-tencent.cjs"
  },
  "build": {
    "appId": "com.phantomtower.studio",
    "productName": "样片工厂",
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "web-dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "presets.json",
          "builtin-presets.json",
          "prompt-templates.json",
          "prompt-templates.defaults.json",
          "builtin-prompt-templates.json",
          "builtin-prompt-templates.defaults.json"
        ]
      },
      {
        "from": "server-dist",
        "to": "server",
        "filter": [
          "index.js"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "latest",
    "archiver": "^8.0.0",
    "element-plus": "^2.14.4",
    "lucide-vue-next": "latest",
    "pinia": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@vitejs/plugin-vue": "latest",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "latest"
  }
}
