{
  "name": "phantom-tower",
  "private": true,
  "version": "0.1.16",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "server": "node server/index.js",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.js",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && npm run build:server && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && npm run build:server && electron-builder --mac dmg zip",
    "license:issue": "node cloudflare-api/scripts/license-manager-tencent.cjs issue",
    "license:revoke": "node cloudflare-api/scripts/license-manager-tencent.cjs revoke",
    "license:admin": "node cloudflare-api/scripts/license-admin-tencent.cjs"
  },
  "build": {
    "appId": "com.phantomtower.studio",
    "productName": "样片工厂",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "mour5474264-dotcom",
      "repo": "PhantomTower",
      "releaseType": "release"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronDist": "C:\\electron-local\\electron-v43.3.0-win32-x64",
    "files": [
      "web-dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "presets.json",
          "builtin-presets.json",
          "prompt-templates.json",
          "prompt-templates.defaults.json",
          "builtin-prompt-templates.json",
          "builtin-prompt-templates.defaults.json"
        ]
      },
      {
        "from": "server-dist",
        "to": "server",
        "filter": [
          "index.js"
        ]
      },
      {
        "from": "vision-models",
        "to": "vision-models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon/phantom-tower.ico",
      "artifactName": "phantom-tower-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "phantom-tower-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "latest",
    "archiver": "^8.0.0",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.4",
    "lucide-vue-next": "latest",
    "onnxruntime-node": "^1.29.0",
    "pinia": "latest",
    "sharp": "^0.35.4",
    "vite": "latest",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@vitejs/plugin-vue": "latest",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "latest"
  }
}
