{
  "name": "phantom-tower",
  "private": true,
  "version": "0.1.18",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "server": "node server/index.js",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.js",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && npm run build:server && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && npm run build:server && electron-builder --mac dmg zip",
    "license:issue": "node cloudflare-api/scripts/license-manager-tencent.cjs issue",
    "license:revoke": "node cloudflare-api/scripts/license-manager-tencent.cjs revoke",
    "license:admin": "node cloudflare-api/scripts/license-admin-tencent.cjs"
  },
  "build": {
    "appId": "com.phantomtower.studio",
    "productName": "样片工厂",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "mour5474264-dotcom",
      "repo": "PhantomTower",
      "releaseType": "release"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "web-dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "presets.json",
          "builtin-presets.json",
          "prompt-templates.json",
          "prompt-templates.defaults.json",
          "builtin-prompt-templates.json",
          "builtin-prompt-templates.defaults.json"
        ]
      },
      {
        "from": "server-dist",
        "to": "server",
        "filter": [
          "index.js"
        ]
      },
      {
        "from": "vision-models",
        "to": "vision-models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon/phantom-tower.ico",
      "artifactName": "phantom-tower-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "phantom-tower-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@element-plus/icons-vue": "^2.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.100.9",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^5.2.0",
    "antd": "^6.4.2",
    "archiver": "^8.0.0",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.4",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "i18next": "^26.3.6",
    "localforage": "^1.10.0",
    "lucide-react": "^1.16.0",
    "lucide-vue-next": "1.0.0",
    "motion": "^12.38.0",
    "onnxruntime-node": "^1.29.0",
    "pinia": "4.0.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.12.0",
    "shadcn": "^4.7.0",
    "sharp": "^0.35.4",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "8.2.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
